[hiddenAction_captureAiHandicap]
autoTriggerOnEvent: created
requireConditional: if self.isControlledByAI() and self.resource('rsAiHandicap') == 0
addResourcesScaledByAIHandicaps: rsAiHandicap=1

[hiddenAction_registerNoticeReceiver]
autoTrigger: if not self.tags(includes='rsNoticeReceiver')
temporarilyAddTags: rsNoticeReceiver

[hiddenAction_recomputeFleetFirepower]
autoTrigger: if self.tags(includes='rsQuantumFleet') and self.tags(includes='rsConstructionComplete')
setUnitStats: shootDamageMultiplier=select(self.hasFlag(id=1),1.1,1)*select(not self.tags(includes='rsJuggernaut') and (self.numberOfUnitsInTeam(withTag='rsJuggernautAuraActive', withinRange=650, greaterThan=0) or self.numberOfUnitsInAllyTeam(withTag='rsJuggernautAuraActive', withinRange=650, greaterThan=0)),1.1,1), shootDelayMultiplier=select(not self.tags(includes='rsJuggernaut') and (self.numberOfUnitsInTeam(withTag='rsJuggernautAuraActive', withinRange=650, greaterThan=0) or self.numberOfUnitsInAllyTeam(withTag='rsJuggernautAuraActive', withinRange=650, greaterThan=0)),1/1.1,1)

addActionCooldownTime: 1s

[hiddenAction_receiveAllyColossusCompletion]
autoTriggerOnEvent: newMessage(withTag='rsAllyColossusCompleted')
requireConditional: if self.resource('rsLastAllyColossusNotice') != eventSource.id
addResourcesWithLogic: rsLastAllyColossusNotice=eventSource.id-self.resource('rsLastAllyColossusNotice')
showMessageToPlayer: Word has reached us that our allies have completed a Colossus and brought it into service. This weapons platform can destroy an entire planet. As ever, they are ahead of their time.
showMessageToPlayer_zh: 我们收到消息，我们的盟友已经完成了巨像的建造并投入服役。这是一种足以彻底毁灭行星的武器平台。一如既往，他们如此超前。
showMessageToPlayer_en: Word has reached us that our allies have completed a Colossus and brought it into service. This weapons platform can destroy an entire planet. As ever, they are ahead of their time.

[hiddenAction_aiEconomyHard]
autoTrigger: if self.tags(includes='rsCapital') and self.isControlledByAI() and self.resource('rsAiHandicap') >= 1.4 and self.resource('rsAiHandicap') < 1.8 and self.customTimer > 10
addResourcesWithLogic: minerals=2/self.numberOfUnitsInTeam(withTag='rsCapital'), alloys=1/self.numberOfUnitsInTeam(withTag='rsCapital'), science=4/self.numberOfUnitsInTeam(withTag='rsCapital'), strategic=0.2/self.numberOfUnitsInTeam(withTag='rsCapital')
resetCustomTimer: true

[hiddenAction_aiEconomyVeryHard]
autoTrigger: if self.tags(includes='rsCapital') and self.isControlledByAI() and self.resource('rsAiHandicap') >= 1.8 and self.resource('rsAiHandicap') < 3.7 and self.customTimer > 10
addResourcesWithLogic: minerals=5/self.numberOfUnitsInTeam(withTag='rsCapital'), alloys=3/self.numberOfUnitsInTeam(withTag='rsCapital'), science=10/self.numberOfUnitsInTeam(withTag='rsCapital'), strategic=0.5/self.numberOfUnitsInTeam(withTag='rsCapital')
resetCustomTimer: true

[hiddenAction_aiEconomyImpossible]
autoTrigger: if self.tags(includes='rsCapital') and self.isControlledByAI() and self.resource('rsAiHandicap') >= 3.7 and self.customTimer > 10
addResourcesWithLogic: minerals=10/self.numberOfUnitsInTeam(withTag='rsCapital'), alloys=6/self.numberOfUnitsInTeam(withTag='rsCapital'), science=20/self.numberOfUnitsInTeam(withTag='rsCapital'), strategic=1/self.numberOfUnitsInTeam(withTag='rsCapital')
resetCustomTimer: true
